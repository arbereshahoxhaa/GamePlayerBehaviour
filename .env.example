# Copy this file to ".env" and fill in your key to use OpenAI.
# The .env file is gitignored, so your key never gets committed.
# If OPENAI_API_KEY is absent, the app automatically uses local Ollama instead.

OPENAI_API_KEY=sk-your-key-here

# Optional overrides:
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_MODEL=llama3.2:latest

# Optional: store pipeline outputs in PostgreSQL (else a local SQLite file is used).
# The target database is created automatically if it doesn't exist.
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/gamexai
